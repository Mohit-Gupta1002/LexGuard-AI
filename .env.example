# ==========================================
# LEXGUARD AI — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. AI Provider Selection (Options: 'gemini', 'openai', 'groq')
# Default: gemini
AI_PROVIDER=gemini

# 2. API Key for your configured provider
# For Google Gemini (recommended):
GEMINI_API_KEY=your_gemini_api_key_here

# For OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here

# Generic / Fallback AI API Key:
# AI_API_KEY=your_api_key_here

# 3. Model Name override (Optional)
# Defaults:
# - gemini: 'gemini-2.5-flash'
# - openai: 'gpt-4o-mini'
# - groq: 'llama-3.3-70b-versatile'
# AI_MODEL=gemini-2.5-flash

# 4. Custom OpenAI-compatible Base URL (e.g. for Groq / Local LLMs / Ollama)
# AI_BASE_URL=https://api.groq.com/openai/v1
